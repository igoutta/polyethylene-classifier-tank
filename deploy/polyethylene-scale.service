[Unit]
Description=Polyethylene Scale Service
After=network.target

[Service]
Type=simple
User=ga
WorkingDirectory=/home/ga/polyethylene-classifier-tank
ExecStart=/home/ga/.local/bin/uv run --extra scale python -m polyethylene_tank.scale
Restart=always
TimeoutStartSec=10
RestartSec=10

[Install]
WantedBy=multi-user.target
