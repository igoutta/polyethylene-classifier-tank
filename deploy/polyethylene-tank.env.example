# Copiar a /etc/polyethylene-tank.env y ajustar:
#   sudo install -m 600 deploy/polyethylene-tank.env.example /etc/polyethylene-tank.env
# Sin TANK_PASSWORD el panel queda abierto a cualquiera en la red.
TANK_USER=admin
TANK_PASSWORD=cambiar-esta-clave

# Servos sin vibración (Pi 4 o anterior): PWM por hardware con pigpio.
# Requiere el servicio pigpiod activo, ver docs/troubleshooting.md.
#GPIOZERO_PIN_FACTORY=pigpio
