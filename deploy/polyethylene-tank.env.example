# Opciones del servicio del tanque. Copiar a /etc/polyethylene-tank.env y ajustar:
#   sudo install -m 600 deploy/polyethylene-tank.env.example /etc/polyethylene-tank.env
#   sudo nano /etc/polyethylene-tank.env
#   sudo systemctl restart polyethylene-classifier-tank
# Detalles en docs/setup.md.

# Contraseña del panel. Sin TANK_PASSWORD el panel queda abierto a cualquiera en la red.
TANK_USER=admin
TANK_PASSWORD=cambiar-esta-clave

# Servos sin vibración (Pi 4): PWM por hardware con pigpio.
# Primero instalar y activar pigpiod (docs/setup.md, "Servos sin vibración");
# después, para activarlo, borrar el # del principio de la línea siguiente:
#GPIOZERO_PIN_FACTORY=pigpio
